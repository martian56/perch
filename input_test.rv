import std.string
from std.test import assert_eq_str, assert_eq_int, assert_true
from "./input" import Parser, Step
from "./keys" import InputEvent, Key, MouseEvent, MouseKind

// Feed a byte list and return the last completed event.
fun feed_all(p: Parser, bytes: list[int]) -> InputEvent {
    var out = InputEvent.Idle
    var i = 0
    while i < bytes.len() {
        match p.feed(bytes[i]) {
            case Ready(e) {
                out = e
            }
            case More {}
        }
        i = i + 1
    }
    return out
}

fun decode(bytes: list[int]) -> str {
    return event_tag(feed_all(Parser.new(), bytes))
}

fun event_tag(e: InputEvent) -> str {
    return match e {
        case KeyPress(k) { "key ${key_tag(k)}" }
        case Mouse(m) { "mouse ${mouse_tag(m)}" }
        case Paste(s) { "paste:${s}" }
        case Idle { "idle" }
        case Closed { "closed" }
    }
}

fun key_tag(k: Key) -> str {
    return match k {
        case Char(c) { "char:${c}" }
        case Enter { "enter" }
        case Tab { "tab" }
        case Backspace { "backspace" }
        case Esc { "esc" }
        case Up { "up" }
        case Down { "down" }
        case Left { "left" }
        case Right { "right" }
        case Home { "home" }
        case End { "end" }
        case PageUp { "pgup" }
        case PageDown { "pgdn" }
        case Insert { "insert" }
        case Delete { "delete" }
        case F(n) { "f${n}" }
        case Ctrl(c) { "ctrl:${c}" }
        case Mod(m) { "mod:${m}" }
    }
}

fun mouse_tag(m: MouseEvent) -> str {
    let kind = match m.kind {
        case Down { "down" }
        case Up { "up" }
        case Drag { "drag" }
        case Move { "move" }
        case ScrollUp { "scrollup" }
        case ScrollDown { "scrolldown" }
    }
    return "${kind} b${m.button} ${m.x},${m.y}"
}

fun test_plain_char() {
    assert_eq_str(decode([97]), "key char:a")
}

fun test_utf8_two_bytes() {
    assert_eq_str(decode([195, 169]), "key char:é")
}

fun test_utf8_three_bytes() {
    assert_eq_str(decode([228, 189, 160]), "key char:你")
}

fun test_enter_both_forms() {
    assert_eq_str(decode([13]), "key enter")
    assert_eq_str(decode([10]), "key enter")
}

fun test_tab() {
    assert_eq_str(decode([9]), "key tab")
}

fun test_backspace_both_forms() {
    assert_eq_str(decode([127]), "key backspace")
    assert_eq_str(decode([8]), "key backspace")
}

fun test_ctrl_letter() {
    assert_eq_str(decode([3]), "key ctrl:c")
    assert_eq_str(decode([1]), "key ctrl:a")
}

fun test_lone_esc_settles_on_flush() {
    let p = Parser.new()
    match p.feed(27) {
        case Ready(e) { assert_eq_str("premature", "event") }
        case More {}
    }
    assert_eq_str(event_tag(p.flush()), "key esc")
}

fun test_arrows() {
    assert_eq_str(decode([27, 91, 65]), "key up")
    assert_eq_str(decode([27, 91, 66]), "key down")
    assert_eq_str(decode([27, 91, 67]), "key right")
    assert_eq_str(decode([27, 91, 68]), "key left")
}

fun test_home_end_letter_form() {
    assert_eq_str(decode([27, 91, 72]), "key home")
    assert_eq_str(decode([27, 91, 70]), "key end")
}

fun test_home_end_tilde_form() {
    assert_eq_str(decode([27, 91, 49, 126]), "key home")
    assert_eq_str(decode([27, 91, 52, 126]), "key end")
}

fun test_insert_delete() {
    assert_eq_str(decode([27, 91, 50, 126]), "key insert")
    assert_eq_str(decode([27, 91, 51, 126]), "key delete")
}

fun test_page_keys() {
    assert_eq_str(decode([27, 91, 53, 126]), "key pgup")
    assert_eq_str(decode([27, 91, 54, 126]), "key pgdn")
}

fun test_function_keys_ss3() {
    assert_eq_str(decode([27, 79, 80]), "key f1")
    assert_eq_str(decode([27, 79, 83]), "key f4")
}

fun test_function_keys_tilde() {
    assert_eq_str(decode([27, 91, 49, 53, 126]), "key f5")
    assert_eq_str(decode([27, 91, 50, 48, 126]), "key f9")
    assert_eq_str(decode([27, 91, 50, 52, 126]), "key f12")
}

fun test_shift_tab() {
    assert_eq_str(decode([27, 91, 90]), "key mod:shift+tab")
}

fun test_modified_keys() {
    // ESC [ 1 ; 5 A is Ctrl+Up, ESC [ 1 ; 2 C Shift+Right, ESC [ 1 ; 6 D
    // Ctrl+Shift+Left, ESC [ 3 ; 5 ~ Ctrl+Delete, ESC [ 1 ; 3 H Alt+Home.
    assert_eq_str(decode([27, 91, 49, 59, 53, 65]), "key mod:ctrl+up")
    assert_eq_str(decode([27, 91, 49, 59, 50, 67]), "key mod:shift+right")
    assert_eq_str(decode([27, 91, 49, 59, 54, 68]), "key mod:ctrl+shift+left")
    assert_eq_str(decode([27, 91, 51, 59, 53, 126]), "key mod:ctrl+delete")
    assert_eq_str(decode([27, 91, 49, 59, 51, 72]), "key mod:alt+home")
    // No modifier parameter, or a plain 1, stays the plain key.
    assert_eq_str(decode([27, 91, 49, 59, 49, 65]), "key up")
}

fun test_mouse_press() {
    // ESC [ < 0 ; 10 ; 5 M
    assert_eq_str(decode([27, 91, 60, 48, 59, 49, 48, 59, 53, 77]), "mouse down b0 10,5")
}

fun test_mouse_release() {
    assert_eq_str(decode([27, 91, 60, 48, 59, 49, 48, 59, 53, 109]), "mouse up b0 10,5")
}

fun test_mouse_right_button() {
    assert_eq_str(decode([27, 91, 60, 50, 59, 55, 59, 56, 77]), "mouse down b2 7,8")
}

fun test_mouse_scroll() {
    assert_eq_str(decode([27, 91, 60, 54, 52, 59, 51, 59, 52, 77]), "mouse scrollup b-1 3,4")
    assert_eq_str(decode([27, 91, 60, 54, 53, 59, 51, 59, 52, 77]), "mouse scrolldown b-1 3,4")
}

fun test_sideways_wheel_is_shift_scroll() {
    // 66 and 67 are the wheel tilted left and right.
    match feed_all(Parser.new(), [27, 91, 60, 54, 54, 59, 51, 59, 52, 77]) {
        case Mouse(m) {
            assert_eq_str(mouse_tag(m), "scrollup b-1 3,4")
            assert_eq_int(m.mods, 1)
        }
        case _ { assert_true(false) }
    }
    match feed_all(Parser.new(), [27, 91, 60, 54, 55, 59, 51, 59, 52, 77]) {
        case Mouse(m) {
            assert_eq_str(mouse_tag(m), "scrolldown b-1 3,4")
            assert_eq_int(m.mods, 1)
        }
        case _ { assert_true(false) }
    }
    match feed_all(Parser.new(), [27, 91, 60, 54, 53, 59, 51, 59, 52, 77]) {
        case Mouse(m) { assert_eq_int(m.mods, 0) }
        case _ { assert_true(false) }
    }
}

fun test_mouse_drag() {
    // Code 32 is button 0 with the motion bit.
    assert_eq_str(decode([27, 91, 60, 51, 50, 59, 55, 59, 56, 77]), "mouse drag b0 7,8")
}

fun test_mouse_move_no_button() {
    // Code 35 is the motion bit with no button held.
    assert_eq_str(decode([27, 91, 60, 51, 53, 59, 49, 59, 50, 77]), "mouse move b-1 1,2")
}

fun test_broken_utf8_recovers() {
    // A lead byte followed by a plain ASCII byte drops the lead.
    assert_eq_str(decode([195, 65]), "key char:A")
}

fun test_parser_reuse_across_events() {
    let p = Parser.new()
    assert_eq_str(event_tag(feed_all(p, [27, 91, 65])), "key up")
    assert_eq_str(event_tag(feed_all(p, [98])), "key char:b")
    assert_eq_str(event_tag(feed_all(p, [27, 91, 60, 48, 59, 49, 59, 49, 77])), "mouse down b0 1,1")
}

// Bracketed paste: ESC[200~ starts, ESC[201~ ends, everything between is
// content delivered as one Paste event.
fun test_paste_arrives_as_one_event() {
    // ESC[200~ h i ESC[201~
    let bytes = [27, 91, 50, 48, 48, 126, 104, 105, 27, 91, 50, 48, 49, 126]
    assert_eq_str(decode(bytes), "paste:hi")
}

fun test_paste_newlines_normalize_and_do_not_submit() {
    // "a" CR "b" pastes as a\nb: the CR is content, not the Enter key.
    let bytes = [27, 91, 50, 48, 48, 126, 97, 13, 98, 27, 91, 50, 48, 49, 126]
    assert_eq_str(decode(bytes), "paste:a\nb")
    // CRLF collapses to one newline.
    let crlf = [27, 91, 50, 48, 48, 126, 97, 13, 10, 98, 27, 91, 50, 48, 49, 126]
    assert_eq_str(decode(crlf), "paste:a\nb")
}

fun test_paste_keeps_a_partial_terminator_as_content() {
    // An ESC then z inside the content: the held ESC flushes back into the
    // paste when the match fails.
    let bytes = [27, 91, 50, 48, 48, 126, 97, 27, 122, 98, 27, 91, 50, 48, 49, 126]
    assert_eq_str(decode(bytes), "paste:a\u{1b}zb")
}

fun test_paste_carries_utf8_content() {
    // é is 195 169.
    let bytes = [27, 91, 50, 48, 48, 126, 195, 169, 27, 91, 50, 48, 49, 126]
    assert_eq_str(decode(bytes), "paste:é")
}

fun test_paste_survives_a_flush_between_reads() {
    let p = Parser.new()
    let head = [27, 91, 50, 48, 48, 126, 104, 105]
    assert_eq_str(event_tag(feed_all(p, head)), "idle")
    // A read timeout mid-paste settles nothing and keeps the content.
    assert_eq_str(event_tag(p.flush()), "idle")
    let tail = [33, 27, 91, 50, 48, 49, 126]
    assert_eq_str(event_tag(feed_all(p, tail)), "paste:hi!")
}

fun test_stray_paste_end_is_ignored() {
    let p = Parser.new()
    assert_eq_str(event_tag(feed_all(p, [27, 91, 50, 48, 49, 126])), "idle")
    assert_eq_str(event_tag(feed_all(p, [113])), "key char:q")
}

fun test_mouse_modifiers() {
    // Shift+click: button code 4 (shift bit) at 10,5.
    let p = Parser.new()
    match feed_all(p, [27, 91, 60, 52, 59, 49, 48, 59, 53, 77]) {
        case Mouse(m) {
            assert_eq_str(mouse_tag(m), "down b0 10,5")
            assert_eq_str("${m.mods}", "1")
        }
        case _ { assert_eq_str("not a mouse event", "mouse") }
    }
    // Ctrl+wheel down: 65 + 16.
    match feed_all(Parser.new(), [27, 91, 60, 56, 49, 59, 49, 59, 49, 77]) {
        case Mouse(m) { assert_eq_str("${m.mods}", "4") }
        case _ { assert_eq_str("not a mouse event", "mouse") }
    }
}

fun test_alt_letter() {
    assert_eq_str(decode([27, 120]), "key mod:alt+x")
    assert_eq_str(decode([27, 49]), "key mod:alt+1")
    // ESC then Enter is not Alt: the Enter arrives on its own.
    assert_eq_str(decode([27, 13]), "key enter")
}
