import std/string
import std/test { assert_eq_str }
import "./input" { Parser, Step }
import "./keys" { InputEvent, Key, MouseEvent, MouseKind }

// Feed a byte list and return the last completed event.
fun feed_all(p: Parser, bytes: List<Int>) -> InputEvent {
    let out = InputEvent.Idle
    let i = 0
    while i < bytes.len() {
        match p.feed(bytes[i]) {
            Ready(e) -> {
                out = e
            },
            More -> {},
        }
        i = i + 1
    }
    return out
}

fun decode(bytes: List<Int>) -> String {
    return event_tag(feed_all(Parser.new(), bytes))
}

fun event_tag(e: InputEvent) -> String {
    return match e {
        KeyPress(k) -> "key ${key_tag(k)}",
        Mouse(m) -> "mouse ${mouse_tag(m)}",
        Idle -> "idle",
        Closed -> "closed",
    }
}

fun key_tag(k: Key) -> String {
    return match k {
        Char(c) -> "char:${c}",
        Enter -> "enter",
        Tab -> "tab",
        Backspace -> "backspace",
        Esc -> "esc",
        Up -> "up",
        Down -> "down",
        Left -> "left",
        Right -> "right",
        Home -> "home",
        End -> "end",
        PageUp -> "pgup",
        PageDown -> "pgdn",
        Insert -> "insert",
        Delete -> "delete",
        F(n) -> "f${n}",
        Ctrl(c) -> "ctrl:${c}",
    }
}

fun mouse_tag(m: MouseEvent) -> String {
    let kind = match m.kind {
        Down -> "down",
        Up -> "up",
        Drag -> "drag",
        Move -> "move",
        ScrollUp -> "scrollup",
        ScrollDown -> "scrolldown",
    }
    return "${kind} b${m.button} ${m.x},${m.y}"
}

fun test_plain_char() {
    assert_eq_str(decode([97]), "key char:a")
}

fun test_utf8_two_bytes() {
    assert_eq_str(decode([195, 169]), "key char:é")
}

fun test_utf8_three_bytes() {
    assert_eq_str(decode([228, 189, 160]), "key char:你")
}

fun test_enter_both_forms() {
    assert_eq_str(decode([13]), "key enter")
    assert_eq_str(decode([10]), "key enter")
}

fun test_tab() {
    assert_eq_str(decode([9]), "key tab")
}

fun test_backspace_both_forms() {
    assert_eq_str(decode([127]), "key backspace")
    assert_eq_str(decode([8]), "key backspace")
}

fun test_ctrl_letter() {
    assert_eq_str(decode([3]), "key ctrl:c")
    assert_eq_str(decode([1]), "key ctrl:a")
}

fun test_lone_esc_settles_on_flush() {
    let p = Parser.new()
    match p.feed(27) {
        Ready(e) -> {
            assert_eq_str("premature", "event")
        },
        More -> {},
    }
    assert_eq_str(event_tag(p.flush()), "key esc")
}

fun test_arrows() {
    assert_eq_str(decode([27, 91, 65]), "key up")
    assert_eq_str(decode([27, 91, 66]), "key down")
    assert_eq_str(decode([27, 91, 67]), "key right")
    assert_eq_str(decode([27, 91, 68]), "key left")
}

fun test_home_end_letter_form() {
    assert_eq_str(decode([27, 91, 72]), "key home")
    assert_eq_str(decode([27, 91, 70]), "key end")
}

fun test_home_end_tilde_form() {
    assert_eq_str(decode([27, 91, 49, 126]), "key home")
    assert_eq_str(decode([27, 91, 52, 126]), "key end")
}

fun test_insert_delete() {
    assert_eq_str(decode([27, 91, 50, 126]), "key insert")
    assert_eq_str(decode([27, 91, 51, 126]), "key delete")
}

fun test_page_keys() {
    assert_eq_str(decode([27, 91, 53, 126]), "key pgup")
    assert_eq_str(decode([27, 91, 54, 126]), "key pgdn")
}

fun test_function_keys_ss3() {
    assert_eq_str(decode([27, 79, 80]), "key f1")
    assert_eq_str(decode([27, 79, 83]), "key f4")
}

fun test_function_keys_tilde() {
    assert_eq_str(decode([27, 91, 49, 53, 126]), "key f5")
    assert_eq_str(decode([27, 91, 50, 48, 126]), "key f9")
    assert_eq_str(decode([27, 91, 50, 52, 126]), "key f12")
}

fun test_shift_tab_maps_to_tab() {
    assert_eq_str(decode([27, 91, 90]), "key tab")
}

fun test_modifier_arrow_keeps_base_key() {
    // Ctrl+Up reports as ESC [ 1 ; 5 A; the modifier is ignored.
    assert_eq_str(decode([27, 91, 49, 59, 53, 65]), "key up")
}

fun test_alt_char_decodes_as_char() {
    assert_eq_str(decode([27, 120]), "key char:x")
}

fun test_mouse_press() {
    // ESC [ < 0 ; 10 ; 5 M
    assert_eq_str(decode([27, 91, 60, 48, 59, 49, 48, 59, 53, 77]), "mouse down b0 10,5")
}

fun test_mouse_release() {
    assert_eq_str(decode([27, 91, 60, 48, 59, 49, 48, 59, 53, 109]), "mouse up b0 10,5")
}

fun test_mouse_right_button() {
    assert_eq_str(decode([27, 91, 60, 50, 59, 55, 59, 56, 77]), "mouse down b2 7,8")
}

fun test_mouse_scroll() {
    assert_eq_str(decode([27, 91, 60, 54, 52, 59, 51, 59, 52, 77]), "mouse scrollup b-1 3,4")
    assert_eq_str(decode([27, 91, 60, 54, 53, 59, 51, 59, 52, 77]), "mouse scrolldown b-1 3,4")
}

fun test_mouse_drag() {
    // Code 32 is button 0 with the motion bit.
    assert_eq_str(decode([27, 91, 60, 51, 50, 59, 55, 59, 56, 77]), "mouse drag b0 7,8")
}

fun test_mouse_move_no_button() {
    // Code 35 is the motion bit with no button held.
    assert_eq_str(decode([27, 91, 60, 51, 53, 59, 49, 59, 50, 77]), "mouse move b-1 1,2")
}

fun test_broken_utf8_recovers() {
    // A lead byte followed by a plain ASCII byte drops the lead.
    assert_eq_str(decode([195, 65]), "key char:A")
}

fun test_parser_reuse_across_events() {
    let p = Parser.new()
    assert_eq_str(event_tag(feed_all(p, [27, 91, 65])), "key up")
    assert_eq_str(event_tag(feed_all(p, [98])), "key char:b")
    assert_eq_str(event_tag(feed_all(p, [27, 91, 60, 48, 59, 49, 59, 49, 77])), "mouse down b0 1,1")
}
