// Input event types. These are plain data: the decoding that produces them
// lives in input.rv, the reading loop in lib.rv.

// A single key press.
enum Key {
    Char(str),
    Enter,
    Tab,
    Backspace,
    Esc,
    Up,
    Down,
    Left,
    Right,
    Home,
    End,
    PageUp,
    PageDown,
    Insert,
    Delete,
    F(int),
    Ctrl(str),
    // A key with modifiers the variants above cannot carry, named like
    // "shift+up", "ctrl+right", "ctrl+shift+left", "shift+tab", "ctrl+delete".
    Mod(str),
}

// What the mouse did.
enum MouseKind {
    Down,
    Up,
    Drag,
    Move,
    ScrollUp,
    ScrollDown,
}

// A mouse event at a 1-based cell position. Button is 0 for left, 1 for
// middle, 2 for right, and -1 when no button applies.
class MouseEvent {
    kind: MouseKind
    button: int
    x: int
    y: int
    // Held modifiers as bits: 1 shift, 2 alt, 4 ctrl.
    mods: int = 0
}

// What read_event hands back. Idle means the timeout passed with nothing
// decoded; Closed means stdin ended. Paste is one whole bracketed paste,
// newlines normalized to \n, so a pasted block arrives as a single event
// instead of a stream of keys (and its newlines cannot submit early).
enum InputEvent {
    KeyPress(Key),
    Mouse(MouseEvent),
    Paste(str),
    Idle,
    Closed,
}
