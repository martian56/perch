// perch: raw terminal control for interactive programs.
//
//     import "github.com/martian56/perch" { Terminal }
//     import "github.com/martian56/perch/keys" { InputEvent, Key }
//
//     let t = Terminal.new()
//     if t.raw_on() {
//         t.write("press q to quit\r\n")
//         let running = true
//         while running {
//             match t.read_event(100) {
//                 KeyPress(k) -> match k {
//                     Char(c) -> { if c == "q" { running = false } },
//                     _ -> {},
//                 },
//                 Closed -> { running = false },
//                 _ -> {},
//             }
//         }
//         t.raw_off()
//     }
//
// Raw mode delivers keys as they are pressed, without echo and without
// waiting for Enter. Ctrl+C arrives as an ordinary key, so quitting is the
// program's decision. The event decoding lives in input.rv, the ANSI
// builders in ansi.rv, and the C shim under c/.

import std/string
import "./sys" { raw_enable, raw_disable, term_cols, term_rows, read_byte, term_write, term_flush }
import "./keys" { InputEvent, Key }
import "./input" { Parser, Step }
import "./ansi" as ansi

// Terminal size in cells.
struct Size {
    w: Int,
    h: Int,
}

// A handle on the interactive terminal. It tracks which modes it switched
// on, so restore can put everything back.
struct Terminal {
    parser: Parser,
    raw: Bool,
    alt: Bool,
    mouse: Bool,
}

impl Terminal {
    fun new() -> Terminal {
        return Terminal { parser: Parser.new(), raw: false, alt: false, mouse: false }
    }

    // Switch raw mode on. False when stdin is not a terminal, which is the
    // signal to skip interactive behavior entirely.
    fun raw_on(self) -> Bool {
        if raw_enable() {
            self.raw = true
            return true
        }
        return false
    }

    fun raw_off(self) {
        if self.raw {
            raw_disable()
            self.raw = false
        }
    }

    // The alternate screen, so the program draws on its own page and the
    // shell scrollback comes back intact on exit.
    fun alt_on(self) {
        self.write(ansi.alt_screen_on())
        self.alt = true
    }

    fun alt_off(self) {
        self.write(ansi.alt_screen_off())
        self.alt = false
    }

    fun mouse_on(self) {
        self.write(ansi.mouse_on())
        self.mouse = true
    }

    fun mouse_off(self) {
        self.write(ansi.mouse_off())
        self.mouse = false
    }

    // Current size, with an 80x24 fallback when stdout is not a terminal.
    fun size(self) -> Size {
        let w = term_cols()
        let h = term_rows()
        if w <= 0 || h <= 0 {
            return Size { w: 80, h: 24 }
        }
        return Size { w, h }
    }

    // Write straight to the terminal. Unlike print, this is not line
    // buffered, so partial lines and escape sequences land immediately.
    fun write(self, s: String) {
        term_write(s)
    }

    fun flush(self) {
        term_flush()
    }

    // Read one input event. A negative timeout blocks until input arrives;
    // otherwise Idle comes back after timeout_ms with nothing decoded.
    // Closed means stdin ended. Bytes that belong to one escape sequence
    // arrive back to back, so once a sequence starts the follow-up reads
    // use a short private timeout; a lone ESC settles as the Esc key.
    fun read_event(self, timeout_ms: Int) -> InputEvent {
        let b = read_byte(timeout_ms)
        if b == -2 {
            return InputEvent.Closed
        }
        if b == -1 {
            return InputEvent.Idle
        }
        let step = self.parser.feed(b)
        while true {
            match step {
                Ready(e) -> {
                    return e
                },
                More -> {
                    let nb = read_byte(6)
                    if nb == -2 {
                        return InputEvent.Closed
                    }
                    if nb == -1 {
                        return self.parser.flush()
                    }
                    step = self.parser.feed(nb)
                },
            }
        }
        return InputEvent.Idle
    }

    // Raw mode plus the usual full-screen setup: alternate screen, hidden
    // cursor, cleared page. False when stdin is not a terminal.
    fun setup(self) -> Bool {
        if !self.raw_on() {
            return false
        }
        self.alt_on()
        self.write(ansi.cursor_hide())
        self.write(ansi.clear_screen())
        self.flush()
        return true
    }

    // Undo whatever setup and mouse_on switched on, in the right order.
    fun restore(self) {
        if self.mouse {
            self.mouse_off()
        }
        self.write(ansi.cursor_show())
        if self.alt {
            self.alt_off()
        }
        self.flush()
        self.raw_off()
    }
}
