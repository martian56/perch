// Run with: rvpm run
// Interactive: shows each decoded event until q, Esc, or Ctrl+C.
from std.io import println
import std.string
from "../lib" import Terminal, Size
from "../keys" import InputEvent, Key, MouseEvent, MouseKind

fun describe_key(k: Key) -> str {
    return match k {
        case Char(c) { "char '${c}'" }
        case Enter { "enter" }
        case Tab { "tab" }
        case Backspace { "backspace" }
        case Esc { "esc" }
        case Up { "up" }
        case Down { "down" }
        case Left { "left" }
        case Right { "right" }
        case Home { "home" }
        case End { "end" }
        case PageUp { "page up" }
        case PageDown { "page down" }
        case Insert { "insert" }
        case Delete { "delete" }
        case F(n) { "F${n}" }
        case Ctrl(c) { "ctrl+${c}" }
        case Mod(m) { m }
    }
}

fun describe_mouse(m: MouseEvent) -> str {
    let kind = match m.kind {
        case Down { "down" }
        case Up { "up" }
        case Drag { "drag" }
        case Move { "move" }
        case ScrollUp { "scroll up" }
        case ScrollDown { "scroll down" }
    }
    return "mouse ${kind}, button ${m.button}, at ${m.x},${m.y}"
}

fun main() {
    let t = Terminal.new()
    let sz = t.size()
    println("terminal is ${sz.w}x${sz.h}")
    if not t.raw_on() {
        println("stdin is not a terminal, nothing to demo")
        return
    }
    t.mouse_on()
    t.paste_on()
    t.write("raw mode on: press keys or click, q or esc quits\r\n")
    var running = true
    while running {
        let e = t.read_event(250)
        match e {
            case KeyPress(k) {
                t.write("${describe_key(k)}\r\n")
                match k {
                    case Char(c) {
                        if c == "q" {
                            running = false
                        }
                    }
                    case Esc {
                        running = false
                    }
                    case Ctrl(c) {
                        if c == "c" {
                            running = false
                        }
                    }
                    case _ {}
                }
            }
            case Mouse(m) { t.write("${describe_mouse(m)}\r\n") }
            case Paste(s) { t.write("paste (${s.length()} bytes)\r\n") }
            case Idle {}
            case Closed {
                running = false
            }
        }
    }
    t.restore()
    println("bye")
}
